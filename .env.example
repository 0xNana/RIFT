# Throwaway deployer key. Never commit the real .env.
PRIVATE_KEY=0x

# Observed Portaldot V3 testnet endpoints. The browser dashboard also reads EVM_RPC
# and CHAIN_ID at Vite startup; those public values are bundled into browser code.
SUBSTRATE_WS=wss://test-node-v3.portaldot.dev
EVM_RPC=https://test-evm-rpc-v3.portaldot.dev
CHAIN_ID=420420777
# Filled in by script/deploy.js after a successful deployment.
REGISTRY_ADDRESS=0x4438B228A44aF949bcb6417BA13536909f3E37A9

# Alert thresholds used by the collector. These are product settings, not protocol limits.
GRANDPA_LAG_THRESHOLD=6
BEEFY_LAG_THRESHOLD=24

# Public values for the dashboard. Vite bundles VITE_ values into browser JavaScript.
# Use only a public RPC endpoint without credentials or query-string tokens.
VITE_REGISTRY_ADDRESS=0x4438B228A44aF949bcb6417BA13536909f3E37A9
VITE_SUBSTRATE_WS=wss://test-node-v3.portaldot.dev
VITE_GRANDPA_LAG_THRESHOLD=6
VITE_BEEFY_LAG_THRESHOLD=24
VITE_HEAD_STALE_AFTER_SECONDS=30
# For a separately hosted dashboard, set this to the RIFT API origin.
# Leave blank when the dashboard and API share an origin.
VITE_API_BASE_URL=
